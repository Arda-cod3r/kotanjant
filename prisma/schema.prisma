// Kotanjant Jant & Aksesuar - Veritabanı Şeması
// Prisma ORM 7 - PostgreSQL
// Şema değişikliğinden sonra: npx prisma migrate dev --name <ad> && npx prisma generate

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// ENUM'LAR
// ---------------------------------------------------------------------------

/// Sistemdeki kullanıcı rolleri. Admin ve üstü yönetim paneline erişebilir.
enum Role {
  CUSTOMER
  ADMIN
  SUPERADMIN
}

/// Sipariş süreç akışı: Hazırlanıyor -> Kargoda -> Teslim Edildi
enum OrderStatus {
  PENDING // Ödeme/beklemede
  PREPARING // Hazırlanıyor
  SHIPPED // Kargoda
  DELIVERED // Teslim Edildi
  CANCELLED // İptal Edildi
  REFUNDED // İade Edildi
}

/// Sipariş kalemi hareketini izlemek için olay tipi
enum OrderEventType {
  CREATED
  STATUS_CHANGED
  NOTE
}

/// Cinsiyet bilgisi (opsiyonel)
enum Gender {
  UNSPECIFIED
  MALE
  FEMALE
  OTHER
}

// ---------------------------------------------------------------------------
// KULLANICILAR & YETKİLENDİRME
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(CUSTOMER)
  phone        String?
  isActive     Boolean  @default(true)

  // Profil detayları (TC opsiyonel; girilirse doğrulanır)
  tcKimlik  String?   @unique
  birthDate DateTime? @db.Date
  gender    Gender    @default(UNSPECIFIED)

  // İletişim tercihleri
  emailOptIn    Boolean @default(true)
  smsOptIn      Boolean @default(false)
  whatsappOptIn Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  addresses Address[]
  wishlist  WishlistItem[]
  reviews   Review[]

  @@index([role])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  fullName   String
  phone      String
  city       String
  district   String
  line1      String
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// KATALOG: Kategori, Marka, Ürün, Görsel, Teknik Özellik
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products Product[]

  @@index([parentId])
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logoUrl   String?
  createdAt DateTime  @default(now())

  products Product[]

  @@index([name])
}

model Product {
  id String @id @default(cuid())

  name        String
  slug        String  @unique
  sku         String  @unique
  shortDesc   String?
  description String

  price        Decimal  @db.Decimal(10, 2)
  comparePrice Decimal? @db.Decimal(10, 2) // Üstü çizili eski fiyat (indirim gösterimi)
  currency     String   @default("TRY")

  stock         Int  @default(0)
  lowStockAlert Int  @default(5)

  // Vitrin bayrakları -> ana sayfadaki tab'ları besler
  isFeatured Boolean @default(false) // Öne Çıkan Ürünler
  isDeal     Boolean @default(false) // Fırsat Ürünleri
  isNew      Boolean @default(true) // Yeni Ürünler
  isActive   Boolean @default(true)

  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  images ProductImage[]
  specs  ProductSpec[]
  tags   String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems   OrderItem[]
  wishlistedBy WishlistItem[]
  reviews      Review[]
  inventoryLogs InventoryLog[]

  @@index([categoryId])
  @@index([brandId])
  @@index([isFeatured])
  @@index([isDeal])
  @@index([isNew])
  @@index([name])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url       String
  alt       String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  @@index([productId])
}

/// Ürün detay sayfasındaki "Teknik Özellikler" tablosu (ör. Jant Çapı: 15 inç)
model ProductSpec {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  label     String
  value     String
  sortOrder Int     @default(0)

  @@index([productId])
}

// ---------------------------------------------------------------------------
// SİPARİŞ & FİNANS
// ---------------------------------------------------------------------------

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  status      OrderStatus @default(PENDING)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Para birimi kırılımı
  subtotal Decimal @db.Decimal(10, 2)
  shipping Decimal @db.Decimal(10, 2) @default(0)
  discount Decimal @db.Decimal(10, 2) @default(0)
  total    Decimal @db.Decimal(10, 2)
  currency String  @default("TRY")

  paymentMethod String @default("COD") // COD | CREDIT_CARD | TRANSFER
  paymentStatus String @default("PENDING") // PENDING | PAID | FAILED | REFUNDED

  // Teslimat anlık görüntüsü (snapshot) - adres sonradan değişse de sipariş korunur
  customerName    String
  customerEmail   String
  customerPhone   String?
  shippingAddress String
  note            String?

  items         OrderItem[]
  events        OrderEvent[]
  inventoryLogs InventoryLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Sipariş anındaki ürün bilgileri (ürün silinse bile fatura doğru kalır)
  name      String
  sku       String
  imageUrl  String?
  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int

  @@index([orderId])
  @@index([productId])
}

/// Sipariş süreç takibi için zaman tüneli (Hazırlanıyor/Kargoda/Teslim Edildi).
model OrderEvent {
  id      String         @id @default(cuid())
  orderId String
  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type    OrderEventType @default(STATUS_CHANGED)

  status      OrderStatus?
  note        String?
  createdById String?
  createdAt   DateTime     @default(now())

  @@index([orderId])
}

/// Stok hareketleri (giriş/çıkış) - stok kontrolü ve denetim için.
model InventoryLog {
  id      String  @id @default(cuid())
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  change    Int
  reason    String
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// ETKİLEŞİM: Favoriler, Yorumlar, Blog
// ---------------------------------------------------------------------------

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  authorName String
  rating     Int
  comment    String
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId])
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  coverImage  String?
  authorName  String    @default("Kotanjant Editör")
  tags        String[]
  isPublished Boolean   @default(true)
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([publishedAt])
}

// ---------------------------------------------------------------------------
// ANA SAYFA VİTRİNİ (HERO SLIDER)
// ---------------------------------------------------------------------------

/// Ana sayfa hero slider slaytları (yönetim panelinden düzenlenir).
model HeroSlide {
  id        String   @id @default(cuid())
  title     String
  subtitle  String
  image     String
  href      String   @default("/urunler")
  cta       String   @default("Keşfet")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

