# ---- Veritabanı (PostgreSQL) ----
# Yerel geliştirme için Docker:
#   docker compose up -d --wait
# Not: 5432 portu makinenizde kullanılıyorsa compose'u POSTGRES_PORT=5434 ile başlatın ve
# aşağıdaki portu buna göre güncelleyin.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kotanjant?schema=public"

# ---- Kimlik doğrulama ----
# openssl rand -base64 32 ile üretin
AUTH_SECRET="degistir-bunu-uzun-rastgele-bir-anahtarla-32+"
# Oturum süresi (saniye) - varsayılan 7 gün
AUTH_SESSION_TTL=604800

# ---- Uygulama ----
NEXT_PUBLIC_SITE_NAME="Kotanjant Jant & Aksesuar"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- İlk süper admin (seed) ----
SEED_ADMIN_EMAIL="superadmin@kotanjant.com"
SEED_ADMIN_PASSWORD="SuperAdmin!234"
SEED_ADMIN_NAME="Süper Admin"
