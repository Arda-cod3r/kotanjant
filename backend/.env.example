PORT=3000
DATABASE_URL=postgresql://randevu:randevu@localhost:5433/randevu?schema=public

# Kimlik doğrulama
JWT_SECRET=dev-secret-degistir-bunu-uretimde
JWT_EXPIRES_IN=7d

# Telefon sağlayıcı: mock | twilio
TELEPHONY_PROVIDER=mock

# Panelin erişmesine izin verilen origin (üretimde kısıtlayın)
CORS_ORIGIN=*

# Otomatik teyit zamanlayıcısı
SCHEDULER_ENABLED=true
SCHEDULER_CRON=*/5 * * * *
